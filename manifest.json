{
  "manifest_version": 3,
  "name": "SyntaxMemo",
  "version": "0.1.0",
  "description": "Your personal memory bank for programming syntax.",
  "permissions": [
    "contextMenus",
    "storage"
  ],
  "background": {
    "service_worker": "background/service-worker.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "SyntaxMemo"
  }
}
